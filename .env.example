# Kopiere diese Datei zu ".env" und trage deine echten API-Schlüssel ein.
# Die ".env"-Datei wird nicht ins Git-Repository übernommen (siehe .gitignore).
ANTHROPIC_API_KEY=

# ElevenLabs (Text-to-Speech). Die Voice-ID findest du in ElevenLabs unter
# "Meine Stimmen" -> Menü der gewünschten Stimme -> "Stimmen-ID kopieren".
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
